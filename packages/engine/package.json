{
  "name": "@gw/engine",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:seed": "wrangler kv key put --local --binding CONFIG config:current --path examples/dev.config.json",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/engine.js"
  },
  "dependencies": {
    "@gw/shared": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.154.0"
  },
  "exports": {
    "./version": "./src/version.ts",
    "./router": "./src/router.ts"
  }
}
