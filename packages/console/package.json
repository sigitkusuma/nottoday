  },
  "devDependencies": {
    "@gw/engine": "*",
    "@gw/shared": "*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.4"
  }
}
